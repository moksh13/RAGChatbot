# Groq Cloud API Configuration
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=

# Current active production models from https://console.groq.com/docs/models:
# - openai/gpt-oss-120b (Recommended: 120B parameter flagship reasoning & instruction model)
# - openai/gpt-oss-20b (Ultra-fast, efficient 20B parameter model)
# - qwen/qwen3.8-27b (27B parameter versatile model)
GROQ_MODEL=openai/gpt-oss-120b
